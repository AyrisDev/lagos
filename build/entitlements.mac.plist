<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron/Node/V8'in JIT'i Hardened Runtime altında bunlar olmadan
       çalışmaz — Electron'un kendi resmi hardened runtime dokümantasyonunun
       önerdiği minimum set (PRD §34: "gerekli entitlement'lar minimum
       seviyede tutulmalı"). Kamera/mikrofon/konum gibi kullanılmayan
       entitlement'lar bilerek eklenmedi. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Backend/Supabase/Google API'lerine giden ağ isteği için gerekli. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
